VITE_API_URL=https://api.liffio.com
VITE_SHORTLINK_PUBLIC_URL=https://go.liffio.com

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry — frontend error tracking, session replay (error sessions only)
# Get DSN from: https://sentry.io → Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Set to git SHA in CI so Sentry can link errors to source maps and commits
VITE_SENTRY_RELEASE=
